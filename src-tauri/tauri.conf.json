{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZeroConverter",
  "version": "0.1.0",
  "identifier": "com.zerofoundry.zeroconverter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZeroConverter",
        "width": 1280,
        "height": 800,
        "minWidth": 1040,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "ZeroFoundry",
    "copyright": "Copyright (c) 2026 ZeroFoundry. MIT License.",
    "category": "Utility",
    "homepage": "https://github.com/ZeroFoundry/ZeroConverter",
    "shortDescription": "Offline file converter for images, audio and video",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "currentUser",
        "languages": [
          "English",
          "Turkish",
          "German",
          "Spanish",
          "French",
          "PortugueseBR",
          "Japanese",
          "Korean",
          "SimpChinese",
          "Russian",
          "Arabic"
        ]
      }
    },
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../licenses/*": "licenses/",
      "../src/assets/fonts/SpaceGrotesk-OFL.txt": "licenses/SpaceGrotesk-OFL.txt",
      "cli/*": "cli/"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzM0E5NkNDMEY3QkQyOEYKUldTUDBuc1B6Slk2NDdyb1hLYzNrMmFsSnc3SGFJRGlNZVdrWHpRamhPNnVOaU1qVWNQVGRmbjgK",
      "endpoints": [
        "https://github.com/zerofoundry/ZeroConverter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
